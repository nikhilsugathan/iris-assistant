# ═══════════════════════════════════════════════════════════════
# IRIS Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# At minimum, you need GROQ_API_KEY for STT and fast LLM inference.
# ═══════════════════════════════════════════════════════════════

# ── API Keys ──────────────────────────────────────────────────
# Get these from each provider's dashboard.
# You need at least ONE LLM provider. Groq is recommended (free tier available).
GROQ_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
PERPLEXITY_API_KEY=

# ── Local LLM (Ollama) ───────────────────────────────────────
# If you have Ollama running locally, IRIS will prefer it for speed.
# Install: https://ollama.ai
# Then: ollama pull phi3.5 && ollama pull llama3.1:8b && ollama pull deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=phi3.5
OLLAMA_MODEL_SMART=llama3.1:8b
OLLAMA_MODEL_DEEP=deepseek-r1:8b

# ── System Identity ──────────────────────────────────────────
# These control how IRIS refers to herself.
IRIS_PUBLIC_NAME=Iris
IRIS_SYSTEM_NAME=IRIS
IRIS_INNER_CODENAME=Aletheia
IRIS_COUNCIL_NAME=Aletheia Council
IRIS_SYSTEM_MOTTO=Perception. Memory. Judgment.

# ── Voice & Speech ───────────────────────────────────────────
# Edge TTS voice. Full list: https://speech.platform.bing.com/consumer/speech/synthesize/readaloud/voices/list?trustedclienttoken=6A5AA1D4EAFF4E9FB37E23D68491D6F4
VOICE_NAME=en-GB-SoniaNeural
VOICE_RATE=+8%

# Set to true to hear voice output even in --text mode
SPEAK_IN_TEXT_MODE=false

# ── Microphone ───────────────────────────────────────────────
# Leave blank to use the system default input device.
# Set to a substring of your mic name (e.g., "Headset") to prefer a specific device.
PREFERRED_MIC_NAME=

# ─────────────────────────────────────────────
# C++ ENGINE PATHS (Phase 1 & 1.5)
# ─────────────────────────────────────────────

# Phase 1: Path to your local GGUF model file
# Download DeepSeek-R1 8B GGUF from: https://huggingface.co/bartowski/DeepSeek-R1-Distill-Llama-8B-GGUF
# Example (Windows):
LOCAL_MODEL_PATH=

# Phase 1.5: Piper TTS
# Download Piper from: https://github.com/rhasspy/piper/releases
# Download voice models from: https://huggingface.co/rhasspy/piper-voices
PIPER_MODEL_PATH=
PIPER_EXE_PATH=piper
