# ═══════════════════════════════════════════════════════════
# IRIS .gitignore
# ═══════════════════════════════════════════════════════════

# ── Secrets — NEVER commit these ─────────────────────────
.env
.env.*
.env.local
.env.production
.env.staging

# ── Python cache ─────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Virtual environments ─────────────────────────────────
venv/
.venv/
env/

# ── Distribution / build ─────────────────────────────────
dist/
build/
*.egg-info/

# ── IRIS runtime data (personal) ─────────────────────────
iris_memory.json
iris_actions.log
*.log

# ── TTS temp artifacts ───────────────────────────────────
# Edge TTS writes MP3s to temp; leaked files end up here
tts_temp/
*.tmp

# ── IDEs ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files ─────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Playwright / browser state ───────────────────────────
browser_data/
